# Configuration Moodle API
# Remplacez YOUR_MOODLE_ADMIN_TOKEN par votre token administrateur Moodle
EXPO_PUBLIC_MOODLE_ADMIN_TOKEN=YOUR_MOODLE_ADMIN_TOKEN

# URL de l'API Moodle (optionnel, défaut: https://moodle.richatt.com)
EXPO_PUBLIC_MOODLE_API_URL=https://moodle.richatt.com

# URLs pour le contenu (optionnel)
EXPO_PUBLIC_EPUB_BASE_URL=https://moodle.richatt.com
EXPO_PUBLIC_AUDIO_BASE_URL=https://moodle.richatt.com
